{
  "name": "bob-pet",
  "displayName": "Bob Pet",
  "version": "0.1.1",
  "publisher": "bob-pet-erickhmel",
  "description": "A pixel-art desktop pet that reacts to what IBM Bob is doing. Windows only for now; macOS and Linux are not supported yet. Not affiliated with IBM.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/EricKhmel/BobPet.git" },
  "homepage": "https://github.com/EricKhmel/BobPet#readme",
  "bugs": { "url": "https://github.com/EricKhmel/BobPet/issues" },
  "private": true,
  "engines": { "vscode": "^1.102.0" },
  "categories": ["Other"],
  "icon": "icon.png",
  "galleryBanner": { "color": "#202126", "theme": "dark" },
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "bobPet.start", "title": "Bob Pet: Start Pet" }, { "command": "bobPet.stop", "title": "Bob Pet: Stop Pet" }, { "command": "bobPet.focus", "title": "Bob Pet: Focus Bob" }, { "command": "bobPet.setState", "title": "Bob Pet: Set Pet State" }, { "command": "bobPet.openSettings", "title": "Bob Pet: Open Settings" }, { "command": "bobPet.connect", "title": "Bob Pet: Connect to IBM Bob" }, { "command": "bobPet.disconnect", "title": "Bob Pet: Disconnect from IBM Bob" }
    ],
    "configuration": { "title": "Bob Pet", "properties": { "bobPet.companionPath": { "type": "string", "scope": "machine", "default": "", "description": "Path to the independently installed Bob Pet companion executable." }, "bobPet.ipcPort": { "type": "number", "scope": "machine", "default": 48173, "minimum": 1024, "maximum": 65535, "description": "Loopback port used only for this VS Code-compatible extension session." }, "bobPet.autoStart": { "type": "boolean", "default": true, "description": "Start the pet automatically when IBM Bob opens." } } }
  },
  "scripts": { "vscode:uninstall": "node ./dist/uninstall.js", "build": "tsc -p tsconfig.json", "test": "npm run build && node --test dist/**/*.test.js", "package": "npm run build && vsce package --target win32-x64 --out ../../dist/bob-pet-0.1.1.vsix" },
  "dependencies": { "@bob-pet/shared": "0.1.1" },
  "devDependencies": { "@types/node": "24.5.2", "@types/vscode": "1.102.0", "@vscode/vsce": "3.6.0", "typescript": "5.9.2" }
}
